#!/usr/bin/env python3
"""Taviq command-line entry point."""
import argparse
import importlib.util
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent

def load(name, file):
    spec = importlib.util.spec_from_file_location(name, ROOT / file)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

installer = load("taviq_installer", "install_basic.py")
doctor = load("taviq_doctor", "doctor.py")
hook_writer = load("taviq_hook_writer", "taviq_prepare_commit_msg.py")

def main():
    parser = argparse.ArgumentParser(prog="taviq", description="AI engineering provenance")
    sub = parser.add_subparsers(dest="command", required=True)

    for name in ("init", "deinit", "install", "uninstall", "doctor"):
        cmd = sub.add_parser(name)
        cmd.add_argument("--repo", type=Path, default=Path("."))
        if name == "doctor":
            cmd.add_argument("--json", action="store_true")

    hook = sub.add_parser("hook")
    hook_sub = hook.add_subparsers(dest="hook_command", required=True)
    prepare = hook_sub.add_parser("prepare-commit-msg")
    prepare.add_argument("message_file")

    args = parser.parse_args()

    if args.command == "hook":
        hook_writer.apply(args.message_file)
        return

    root = installer.repo_root(args.repo)

    if args.command in ("init", "install"):
        if args.command == "install":
            print("warning: 'taviq install' is a v0.1 compatibility alias for 'taviq init'")
        installer.install(root)
        return

    if args.command in ("deinit", "uninstall"):
        if args.command == "uninstall":
            print("warning: 'taviq uninstall' is a v0.1 compatibility alias for 'taviq deinit'")
        installer.uninstall(root)
        return

    result = doctor.diagnose(root)
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print("Taviq Doctor:", result["status"])
        for name, ok in result["checks"].items():
            print(("✓" if ok else "✗"), name)
        print("Core provenance:", "ready" if result["core_ready"] else "incomplete")
        print("GitHub PR summary:", "enabled" if result["optional"]["github_pr_summary"] else "optional/not installed")
    raise SystemExit(0 if result["core_ready"] else 1)

if __name__ == "__main__":
    main()
