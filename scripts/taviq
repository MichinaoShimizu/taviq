#!/usr/bin/env python3
"""Taviq command-line entry point."""
import argparse, importlib.util
from pathlib import Path

ROOT=Path(__file__).resolve().parent

def load(name,file):
    spec=importlib.util.spec_from_file_location(name,ROOT/file)
    mod=importlib.util.module_from_spec(spec); spec.loader.exec_module(mod); return mod

installer=load("taviq_installer","install_basic.py")
doctor=load("taviq_doctor","doctor.py")

def main():
    p=argparse.ArgumentParser(prog="taviq",description="AI engineering provenance")
    sub=p.add_subparsers(dest="command",required=True)
    for name in ("init","deinit","install","uninstall","doctor"):
        q=sub.add_parser(name)
        q.add_argument("--repo",type=Path,default=Path("."))
        if name=="doctor": q.add_argument("--json",action="store_true")
    a=p.parse_args()
    root=installer.repo_root(a.repo)
    if a.command=="install": installer.install(root); return
    if a.command=="uninstall": installer.uninstall(root); return
    result=doctor.diagnose(root)
    if a.json:
        import json; print(json.dumps(result,indent=2))
    else:
        print("Taviq Doctor:",result["status"])
        for name,ok in result["checks"].items(): print(("✓" if ok else "✗"),name)
        print("Core provenance:","ready" if result["core_ready"] else "incomplete")
        print("GitHub PR summary:","enabled" if result["optional"]["github_pr_summary"] else "optional/not installed")
    raise SystemExit(0 if result["core_ready"] else 1)

if __name__=="__main__": main()
